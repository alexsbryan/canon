# From the Slack app: OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# From the Slack app: Basic Information → App-Level Tokens (scope connections:write)
SLACK_APP_TOKEN=xapp-...
# The house channel's id: open the channel, click its name, copy the id at the bottom.
CANON_CHANNEL=C0...
# You, for the setup commands you run with ./house. Your Slack full name.
YOUR_NAME=

# The room every proposal from Slack goes into.
CANON_SCOPE=house

# Optional: commit and push the record after every write.
CANON_GIT_SYNC=0

# Optional: for `/canon ask` and for importing your notes.
# CANON_ENDPOINT=http://your-model-server:8080/v1
# CANON_MODEL=your-model-name
# CANON_API_KEY=
# Set to 1 only if the house agreed to send rules and plans to a model
# that is not on this server.
CANON_ALLOW_REMOTE=0
