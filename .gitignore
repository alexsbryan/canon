/target
**/*.rs.bk
.DS_Store

# NOT ignored: /.canon/ is this project's own canon. Its rules are this
# repository's rules and CONTRIBUTING.md links into them. What inside it
# belongs to one machine rather than to the group is listed in
# .canon/.gitignore. Every script that exercises the tool sets CANON_DIR to
# a scratch directory, so running the demo or the bars cannot dirty it.

# Sweep provenance for a DIRTY tree: the patch and tarball exist so a run
# made from uncommitted work can be reconstructed. Once the work is
# committed the commit line in BUILD.txt says the same thing, and a
# tarball of the working tree does not belong in the tree.
fixtures/*/runs/*/tree.patch
fixtures/*/runs/*/tree.status
fixtures/*/runs/*/tree-untracked.tgz

# build.py leaves one behind on every fixture rebuild.
__pycache__/
